# 1Password secret references — resolved by `op run` at server startup
# These are NOT read by Dotenvy; they are injected as OS env vars by `op run`
WORKOS_API_KEY=op://frontman/workos dev env/WORKOS_API_KEY
WORKOS_CLIENT_ID=op://frontman/workos dev env/WORKOS_CLIENT_ID
OIDC_ISSUER=op://frontman/oidc dev env/OIDC_ISSUER
OIDC_CLIENT_ID=op://frontman/oidc dev env/OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=op://frontman/oidc dev env/OIDC_CLIENT_SECRET
